{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "antifraud",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.api.main:create_app",
        "--factory",
        "--app-dir",
        "backend",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "pages-demo",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8001",
        "--directory",
        "_pages_preview"
      ],
      "port": 8001
    }
  ]
}